# .gitignore

# Hidden Vagrant-directory
.vagrant

# Backup files (e.g. Vim, Gedit, etc.)
*~

# Vagrant base boxes (you never know when someone puts one in the repository)
*.box

# Python artefacts
.ropeproject
*.pyc
__pycache__/
.pytest_cache/
.venv/

# Ignore legacy test directories
vagrant-tests/
docker-tests/

# Ignore editor directories
/.idea
/.vscode

# Ignore Ansible fact cache and project-local collections
.cache/
.ansible/

# Local Molecule logs from molecule/run-all.sh
.molecule-logs/
